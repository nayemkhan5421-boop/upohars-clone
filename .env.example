# ---- Telegram ----
# BotFather theke pawa token (@BotFather -> /newbot)
BOT_TOKEN=123456789:AA...
# BotFather theke pawa bot username (without @)
BOT_USERNAME=UpoharsBot
# Withdrawal approve/reject korte pare emon shobar Telegram numeric ID, comma diye alada kora
# example: ADMIN_TELEGRAM_IDS=5672570073,1234567890
ADMIN_TELEGRAM_IDS=5672570073

# ---- Web App ----
# Deploy korar por ei app-er public URL (Render/Railway/Vercel diye pabe)
# example: https://upohars-clone.onrender.com
WEBAPP_URL=https://your-app-url.example.com
PORT=3000

# ---- Firebase ----
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Shei JSON file-er content ekhane paste korte hobe (single line, escaped)
# Shohoj upay: FIREBASE_SERVICE_ACCOUNT_BASE64 e base64-encoded JSON dao
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Ad network (Adsgram) ----
# adsgram.ai te publisher account banale ei Block ID pabe
ADSGRAM_BLOCK_ID=int-00000

# ---- Admin panel (multi-admin) ----
# Pratham bar server run korle ei username/password diye "owner" account bootstrap hobe.
# Erpor /admin panel-er "Admins" tab theke aro admin add kora jabe.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-strong-password
# Login token sign korte ekta random shokto string dao (kauke share korba na)
ADMIN_JWT_SECRET=change-this-to-a-long-random-string

# ---- App settings (defaults, Firestore settings/config diye override hoy) ----
MIN_WITHDRAW_BALANCE=0.15
MIN_REFERRALS=2
REFERRAL_BONUS=0.02
FRIEND_BONUS=0.01
DAILY_AD_LIMIT=50
AD_REWARD=0.003
